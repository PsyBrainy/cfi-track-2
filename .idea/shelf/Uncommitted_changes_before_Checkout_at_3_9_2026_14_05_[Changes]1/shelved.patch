<+>/* ============================\r\n   Variables de marca: Alkywall\r\n   ============================ */\r\n:root {\r\n  /* Colores primarios */\r\n  --color-primary: #2563eb;\r\n  --color-primary-dark: #1d4ed8;\r\n  --color-secondary: #10b981;\r\n  --color-bg: #f8fafc;\r\n  --color-surface: #ffffff;\r\n  --color-text: #1e293b;\r\n  --color-text-muted: #64748b;\r\n  --color-border: #e2e8f0;\r\n\r\n  /* Tipografías */\r\n  --font-heading: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\r\n  --font-body: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\r\n\r\n  /* Espaciado y bordes */\r\n  --radius: 8px;\r\n  --spacing-sm: 0.5rem;\r\n  --spacing-md: 1rem;\r\n  --spacing-lg: 2rem;\r\n  --max-width: 1100px;\r\n}\r\n\r\n/* ============================\r\n   Reset básico\r\n   ============================ */\r\n* {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\nbody {\r\n  font-family: var(--font-body);\r\n  color: var(--color-text);\r\n  background-color: var(--color-bg);\r\n  line-height: 1.5;\r\n}\r\n\r\nh1, h2, h3 {\r\n  font-family: var(--font-heading);\r\n  color: var(--color-text);\r\n}\r\n\r\na {\r\n  text-decoration: none;\r\n  color: inherit;\r\n}\r\n\r\n.container {\r\n  max-width: var(--max-width);\r\n  margin: 0 auto;\r\n  padding: 0 var(--spacing-md);\r\n}\r\n\r\n/* ============================\r\n   Header\r\n   ============================ */\r\n.site-header {\r\n  background-color: var(--color-surface);\r\n  border-bottom: 1px solid var(--color-border);\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 10;\r\n}\r\n\r\n.header__inner {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding-top: var(--spacing-md);\r\n  padding-bottom: var(--spacing-md);\r\n  flex-wrap: wrap;\r\n  gap: var(--spacing-sm);\r\n  position: relative;\r\n}\r\n\r\n.logo {\r\n  font-size: 1.25rem;\r\n  font-weight: 700;\r\n  color: var(--color-primary);\r\n}\r\n\r\n.nav__list {\r\n  display: flex;\r\n  gap: var(--spacing-lg);\r\n  list-style: none;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.nav__list a {\r\n  color: var(--color-text-muted);\r\n  font-weight: 500;\r\n}\r\n\r\n.nav__list a:hover {\r\n  color: var(--color-primary);\r\n}\r\n\r\n/* Nav responsive con hamburguesa: botón base (líneas 104-122) */\r\n.nav-toggle {\r\n  display: none;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  gap: 5px;\r\n  width: 32px;\r\n  height: 32px;\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 0;\r\n}\r\n\r\n.nav-toggle span {\r\n  display: block;\r\n  height: 2px;\r\n  width: 100%;\r\n  background-color: var(--color-text);\r\n}\r\n\r\n/* ============================\r\n   Main / Hero\r\n   ============================ */\r\n.site-main {\r\n  padding-top: var(--spacing-lg);\r\n  padding-bottom: var(--spacing-lg);\r\n}\r\n\r\n.hero {\r\n  text-align: center;\r\n  padding: var(--spacing-lg) var(--spacing-md);\r\n  margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n.hero h1 {\r\n  font-size: 2rem;\r\n  margin-bottom: var(--spacing-sm);\r\n}\r\n\r\n.hero p {\r\n  color: var(--color-text-muted);\r\n  margin-bottom: var(--spacing-md);\r\n}\r\n\r\n.btn {\r\n  display: inline-block;\r\n  padding: 0.75rem 1.5rem;\r\n  border-radius: var(--radius);\r\n  border: none;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  font-size: 1rem;\r\n}\r\n\r\n.btn--primary {\r\n  background-color: var(--color-primary);\r\n  color: #ffffff;\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\n.btn--primary:hover {\r\n  background-color: var(--color-primary-dark);\r\n}\r\n\r\n/* ============================\r\n   Cards (Grid responsive)\r\n   ============================ */\r\n.cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\r\n  gap: var(--spacing-md);\r\n}\r\n\r\n.card {\r\n  background-color: var(--color-surface);\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  padding: var(--spacing-md);\r\n}\r\n\r\n.card h2 {\r\n  font-size: 1.1rem;\r\n  margin-bottom: var(--spacing-sm);\r\n  color: var(--color-primary);\r\n}\r\n\r\n.card p {\r\n  color: var(--color-text-muted);\r\n  font-size: 0.95rem;\r\n}\r\n\r\n/* ================================================== */\r\n/* Sección de registro/login (líneas 198-303)          */\r\n/* ================================================== */\r\n.auth-section {\r\n  max-width: 420px; /* mismo ancho que tenía .register */\r\n  margin: var(--spacing-lg) auto 0; /* centrado con espacio arriba */\r\n  background-color: var(--color-surface); /* fondo blanco, igual que .card */\r\n  border: 1px solid var(--color-border); /* borde sutil consistente con el resto */\r\n  border-radius: var(--radius); /* mismos bordes redondeados de la marca */\r\n  padding: var(--spacing-lg); /* aire interno */\r\n}\r\n\r\n/* Oculta toda la sección hasta que se clickee \"Empezar ahora\" */\r\n.auth-section--hidden {\r\n  display: none;\r\n}\r\n\r\n/* Variante ancha: la usa el registro, que tiene muchos más campos que el login */\r\n.auth-section--wide {\r\n  max-width: 680px;\r\n}\r\n\r\n.auth-section h2 {\r\n  text-align: center;\r\n  margin-bottom: var(--spacing-md);\r\n  color: var(--color-primary);\r\n}\r\n\r\n.auth-form {\r\n  display: flex; /* Flexbox: apila los campos verticalmente */\r\n  flex-direction: column; /* dirección vertical */\r\n  gap: var(--spacing-md); /* separación entre inputs */\r\n}\r\n\r\n/* Grid de 2 columnas para el formulario de registro (muchos campos) */\r\n.form-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr); /* 2 columnas iguales en desktop */\r\n  gap: var(--spacing-md);\r\n}\r\n\r\n/* Campos que necesitan ocupar el ancho completo (Dirección, Código postal) */\r\n.form-group--full {\r\n  grid-column: 1 / -1; /* de la primera a la última columna */\r\n}\r\n\r\n.form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.form-group label {\r\n  font-weight: 500;\r\n  font-size: 0.9rem;\r\n  color: var(--color-text);\r\n}\r\n\r\n.form-group input,\r\n.form-group select {\r\n  padding: 0.6rem;\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius);\r\n  font-family: var(--font-body);\r\n  font-size: 1rem;\r\n  background-color: var(--color-surface);\r\n}\r\n\r\n.form-group input:focus,\r\n.form-group select:focus {\r\n  outline: none;\r\n  border-color: var(--color-primary);\r\n}\r\n\r\n.form-group select:disabled {\r\n  background-color: var(--color-bg); /* gris para marcar visualmente que está deshabilitado */\r\n  color: var(--color-text-muted);\r\n  cursor: not-allowed;\r\n}\r\n\r\n.form-group input.input--error,\r\n.form-group select.input--error {\r\n  border-color: #dc2626;\r\n}\r\n\r\n.error-message {\r\n  color: #dc2626;\r\n  font-size: 0.85rem;\r\n  min-height: 1em; /* evita que el layout salte cuando aparece/desaparece */\r\n}\r\n\r\n/* Mensaje general de error del servidor (401/403), va vacío hasta que el JS lo llena */\r\n.form-feedback {\r\n  font-size: 0.9rem;\r\n  text-align: center;\r\n}\r\n\r\n/* Variante de error: la agrega el JS cuando el login falla por credenciales inválidas */\r\n.form-feedback--error {\r\n  color: #dc2626;\r\n  background-color: #fef2f2; /* fondo rojo muy suave para resaltar el bloque */\r\n  border: 1px solid #fecaca;\r\n  border-radius: var(--radius);\r\n  padding: var(--spacing-sm);\r\n}\r\n\r\n.auth-form .btn {\r\n  margin-top: var(--spacing-sm); /* separa el botón submit de los inputs */\r\n}\r\n\r\n/* ============================\r\n   Footer\r\n   ============================ */\r\n.site-footer {\r\n  background-color: var(--color-surface);\r\n  border-top: 1px solid var(--color-border);\r\n  padding: var(--spacing-md) 0;\r\n  text-align: center;\r\n  color: var(--color-text-muted);\r\n  font-size: 0.9rem;\r\n}\r\n\r\n/* ============================\r\n   Responsive: mobile\r\n   ============================ */\r\n@media (max-width: 600px) {\r\n  /* Nav responsive con hamburguesa: comportamiento mobile (líneas 211-238) */\r\n  .nav-toggle {\r\n    display: flex;\r\n  }\r\n\r\n  .nav {\r\n    display: none; /* oculto por defecto: no ocupa espacio ni tapa nada */\r\n    position: absolute;\r\n    top: 100%;\r\n    left: 0;\r\n    right: 0;\r\n    background-color: var(--color-surface);\r\n    border-bottom: 1px solid var(--color-border);\r\n  }\r\n\r\n  .nav.nav--open {\r\n    display: block; /* solo aparece cuando el usuario lo abre */\r\n  }\r\n\r\n  .nav__list {\r\n    flex-direction: column;\r\n    gap: 0;\r\n  }\r\n\r\n  .nav__list a {\r\n    display: block;\r\n    padding: var(--spacing-md);\r\n    border-top: 1px solid var(--color-border);\r\n  }\r\n\r\n  .hero h1 {\r\n    font-size: 1.5rem;\r\n  }\r\n\r\n  /* El grid de 2 columnas del registro colapsa a 1 en mobile */\r\n  .form-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}
