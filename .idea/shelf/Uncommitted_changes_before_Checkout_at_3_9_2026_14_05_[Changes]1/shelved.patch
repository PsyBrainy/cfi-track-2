<+><!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Alkywall</title>\r\n    <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body>\r\n\r\n<header class=\"site-header\">\r\n    <div class=\"container header__inner\">\r\n        <a href=\"#\" class=\"logo\">Alkywall</a>\r\n\r\n        <!-- Nav responsive con hamburguesa: líneas 15-28 -->\r\n        <button class=\"nav-toggle\" aria-label=\"Abrir menú\" aria-expanded=\"false\" aria-controls=\"nav-menu\">\r\n            <span></span>\r\n            <span></span>\r\n            <span></span>\r\n        </button>\r\n\r\n        <nav class=\"nav\" id=\"nav-menu\">\r\n            <ul class=\"nav__list\">\r\n                <li><a href=\"#inicio\">Inicio</a></li>\r\n                <li><a href=\"#billetera\">Mi billetera</a></li>\r\n                <li><a href=\"#movimientos\">Movimientos</a></li>\r\n                <li><a href=\"#contacto\">Contacto</a></li>\r\n                <!-- Link que abre la pantalla de login -->\r\n                <li><a href=\"#login\" id=\"nav-login-link\">Iniciar sesión</a></li>\r\n            </ul>\r\n        </nav>\r\n    </div>\r\n</header>\r\n\r\n<main class=\"site-main container\">\r\n    <section id=\"inicio\" class=\"hero\">\r\n        <h1>Bienvenido a Alkywall</h1>\r\n        <p>Tu billetera virtual simple, ordenada y segura.</p>\r\n        <button class=\"btn btn--primary\" id=\"start-button\">Empezar ahora</button>\r\n    </section>\r\n\r\n    <section id=\"billetera\" class=\"cards\">\r\n        <article class=\"card\">\r\n            <h2>Saldo disponible</h2>\r\n            <p>Consultá tu saldo en tiempo real.</p>\r\n        </article>\r\n        <article class=\"card\">\r\n            <h2>Transferencias</h2>\r\n            <p>Enviá y recibí dinero fácilmente.</p>\r\n        </article>\r\n        <article class=\"card\">\r\n            <h2>Historial</h2>\r\n            <p>Revisá todos tus movimientos.</p>\r\n        </article>\r\n    </section>\r\n\r\n    <!-- ============================================ -->\r\n    <!-- Sección de registro: líneas 57-206 -->\r\n    <!-- Arranca oculta con \"auth-section--hidden\", la muestra \"Empezar ahora\" -->\r\n    <!-- Campos requeridos por el backend en /api/auth/register (13 campos) -->\r\n    <!-- ============================================ -->\r\n    <section id=\"registro\" class=\"auth-section auth-section--hidden auth-section--wide\">\r\n        <h2>Creá tu cuenta</h2>\r\n\r\n        <form id=\"register-form\" class=\"auth-form\" novalidate>\r\n            <div class=\"form-grid\">\r\n\r\n                <!-- name -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"nombre\">Nombre</label>\r\n                    <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Tu nombre\">\r\n                    <span class=\"error-message\" id=\"nombre-error\"></span>\r\n                </div>\r\n\r\n                <!-- lastName -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"apellido\">Apellido</label>\r\n                    <input type=\"text\" id=\"apellido\" name=\"apellido\" placeholder=\"Tu apellido\">\r\n                    <span class=\"error-message\" id=\"apellido-error\"></span>\r\n                </div>\r\n\r\n                <!-- email -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"email\">Email</label>\r\n                    <input type=\"text\" id=\"email\" name=\"email\" placeholder=\"tuemail@ejemplo.com\">\r\n                    <span class=\"error-message\" id=\"email-error\"></span>\r\n                </div>\r\n\r\n                <!-- password -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"password\">Contraseña</label>\r\n                    <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"Mínimo 8 caracteres\">\r\n                    <span class=\"error-message\" id=\"password-error\"></span>\r\n                </div>\r\n\r\n                <!-- birthDate -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"fechaNacimiento\">Fecha de nacimiento</label>\r\n                    <input type=\"date\" id=\"fechaNacimiento\" name=\"fechaNacimiento\">\r\n                    <span class=\"error-message\" id=\"fechaNacimiento-error\"></span>\r\n                </div>\r\n\r\n                <!-- gender: lista de 3 opciones -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"genero\">Género</label>\r\n                    <select id=\"genero\" name=\"genero\">\r\n                        <option value=\"\">Seleccioná una opción</option>\r\n                        <option value=\"femenino\">Femenino</option>\r\n                        <option value=\"masculino\">Masculino</option>\r\n                        <option value=\"otro\">Otro</option>\r\n                    </select>\r\n                    <span class=\"error-message\" id=\"genero-error\"></span>\r\n                </div>\r\n\r\n                <!-- dni -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"dni\">DNI</label>\r\n                    <input type=\"text\" id=\"dni\" name=\"dni\" placeholder=\"Sin puntos ni espacios\">\r\n                    <span class=\"error-message\" id=\"dni-error\"></span>\r\n                </div>\r\n\r\n                <!-- phoneNumber -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"telefono\">Teléfono</label>\r\n                    <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"Ej: 2920123456\">\r\n                    <span class=\"error-message\" id=\"telefono-error\"></span>\r\n                </div>\r\n\r\n                <!-- employment: lista de opciones -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"ocupacion\">Situación laboral</label>\r\n                    <select id=\"ocupacion\" name=\"ocupacion\">\r\n                        <option value=\"\">Seleccioná una opción</option>\r\n                        <option value=\"empleado\">Empleado/a en relación de dependencia</option>\r\n                        <option value=\"independiente\">Independiente / Autónomo</option>\r\n                        <option value=\"desempleado\">Desempleado/a</option>\r\n                        <option value=\"estudiante\">Estudiante</option>\r\n                        <option value=\"jubilado\">Jubilado/a</option>\r\n                    </select>\r\n                    <span class=\"error-message\" id=\"ocupacion-error\"></span>\r\n                </div>\r\n\r\n                <!-- address: ocupa el ancho completo de la grilla -->\r\n                <div class=\"form-group form-group--full\">\r\n                    <label for=\"direccion\">Dirección</label>\r\n                    <input type=\"text\" id=\"direccion\" name=\"direccion\" placeholder=\"Calle y número\">\r\n                    <span class=\"error-message\" id=\"direccion-error\"></span>\r\n                </div>\r\n\r\n                <!-- province: se completa dinámicamente en JS con la API de Georef -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"provincia\">Provincia</label>\r\n                    <select id=\"provincia\" name=\"provincia\" disabled>\r\n                        <option value=\"\">Cargando provincias...</option>\r\n                    </select>\r\n                    <span class=\"error-message\" id=\"provincia-error\"></span>\r\n                </div>\r\n\r\n                <!-- city: se completa dinámicamente en JS según la provincia elegida (API de Georef) -->\r\n                <div class=\"form-group\">\r\n                    <label for=\"ciudad\">Ciudad</label>\r\n                    <select id=\"ciudad\" name=\"ciudad\" disabled>\r\n                        <option value=\"\">Elegí primero una provincia</option>\r\n                    </select>\r\n                    <span class=\"error-message\" id=\"ciudad-error\"></span>\r\n                </div>\r\n\r\n                <!-- postalCode -->\r\n                <div class=\"form-group form-group--full\">\r\n                    <label for=\"codigoPostal\">Código postal</label>\r\n                    <input type=\"text\" id=\"codigoPostal\" name=\"codigoPostal\" placeholder=\"Ej: 8500\">\r\n                    <span class=\"error-message\" id=\"codigoPostal-error\"></span>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <!-- Mensaje general de error del servidor -->\r\n            <div class=\"form-feedback\" id=\"register-feedback\"></div>\r\n\r\n            <button type=\"submit\" class=\"btn btn--primary\">Registrarme</button>\r\n        </form>\r\n    </section>\r\n\r\n    <!-- ============================================ -->\r\n    <!-- Sección de login: líneas 209-234 -->\r\n    <!-- Arranca oculta con \"auth-section--hidden\", la muestra el link \"Iniciar sesión\" del nav -->\r\n    <!-- ============================================ -->\r\n    <section id=\"login\" class=\"auth-section auth-section--hidden\">\r\n        <h2>Iniciar sesión</h2>\r\n\r\n        <form id=\"login-form\" class=\"auth-form\" novalidate>\r\n            <div class=\"form-group\">\r\n                <label for=\"login-email\">Email</label>\r\n                <input type=\"text\" id=\"login-email\" name=\"login-email\" placeholder=\"tuemail@ejemplo.com\">\r\n                <span class=\"error-message\" id=\"login-email-error\"></span>\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label for=\"login-password\">Contraseña</label>\r\n                <input type=\"password\" id=\"login-password\" name=\"login-password\" placeholder=\"Tu contraseña\">\r\n                <span class=\"error-message\" id=\"login-password-error\"></span>\r\n            </div>\r\n\r\n            <!-- Mensaje general de error del servidor (401/403), distinto del error por campo -->\r\n            <div class=\"form-feedback\" id=\"login-feedback\"></div>\r\n\r\n            <button type=\"submit\" class=\"btn btn--primary\">Ingresar</button>\r\n        </form>\r\n    </section>\r\n</main>\r\n\r\n<footer class=\"site-footer\">\r\n    <div class=\"container\">\r\n        <p>&copy; 2026 Alkywall. Todos los derechos reservados.</p>\r\n    </div>\r\n</footer>\r\n\r\n<script src=\"main.js\"></script>\r\n</body>\r\n</html>
